{
    "name": "havel09/achievement-tracker",
    "description": "Tracker de succes Steam : bibliotheque, progression et checklist des succes.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "slim/php-view": "^3.2",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public public/index.php"
    }
}
